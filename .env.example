# Client's Supabase project -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Telegram message to Jigyasa for every new bid.
# Bot token from @BotFather; chat id = her Telegram user id (message the bot once, then
# open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed if NOT hosting on Vercel: the site's public address, used for link previews.
SITE_URL=
